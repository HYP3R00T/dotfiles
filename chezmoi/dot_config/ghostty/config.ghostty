theme = Catppuccin Mocha

font-family = "FiraCode Nerd Font Mono"
font-size = 13
font-feature = +calt
font-feature = +liga
font-feature = +dlig

keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+alt+f=toggle_window_decorations

# Start borderless; Ctrl+Alt+F restores or hides decorations on demand.
window-decoration = none

# Keep terminal content comfortably away from the window edges.
window-padding-x = 20
window-padding-y = 14

confirm-close-surface = false
