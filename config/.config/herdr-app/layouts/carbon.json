{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46.0
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1.0
              },
              "min": 90.0
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1.0
              },
              "min": 90.0
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69.0
          }
        }
      ],
      "size": {
        "px": 238
      },
      "min": 44.0,
      "max": 480.0,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 40
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 28,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 0,
                    "color": "border"
                  },
                  "focus": {
                    "width": 0,
                    "color": "border"
                  },
                  "radius": 0,
                  "gap": 3,
                  "lone": true,
                  "veil": 0.16
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "carbon-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "carbon-changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368.0
              },
              "min": 280.0,
              "max": 900.0,
              "hidden": true
            }
          ],
          "padding": 0,
          "gap": 0,
          "divider": {
            "width": 1,
            "color": "border"
          }
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 26
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    16,
    12
  ],
  "divider": {
    "width": 1.0,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12.0,
    16.0
  ],
  "theme": {
    "light": "paper",
    "dark": "linear-carbon"
  }
}
