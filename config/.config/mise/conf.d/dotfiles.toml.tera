{% set profile = read_toml(path=vars.dotfiles_profile) -%}
# Generated by mise from the dotfiles.toml.tera file in the checkout.
[settings.dotfiles]
root = {{ vars.dotfiles_checkout | json_encode }}
default_mode = "copy"

[dotfile_groups.home]
root = {{ vars.dotfiles_checkout | json_encode }}
mode = "copy"
exclude = [
{% for pattern in profile.dotfile_groups.home.exclude -%}
  {{ pattern | json_encode }},
{% endfor -%}
  "/.config/mise/conf.d/dotfiles.toml",
  "/.config/mise/conf.d/dotfiles.toml.tera",
]

[dotfile_groups.home.entries]
{% for path, entry in profile.dotfile_groups.home.entries -%}
{% if entry.mode == "copy" and (entry.variants is undefined or (mise_env is defined and "omarchy" in mise_env and entry.variants[0].profile == "omarchy")) -%}
{{ path | json_encode }} = { mode = "copy"{% if entry.permissions is defined %}, permissions = {{ entry.permissions | json_encode }}{% endif %} }
{% endif -%}
{% endfor -%}
